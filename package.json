{
  "name": "farm-website",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "watch:css": "tailwindcss -i ./styles.css -o ./dist/output.css --watch",
    "build:css": "tailwindcss -i ./styles.css -o ./dist/output.css",
    "serve": "live-server dist --port=3000 --no-browser",
    "clean": "rimraf dist",
    "copy": "copyfiles -u 2 \"public/images/**/*\" dist/images && copyfiles index.html dist",
    "mkdir": "mkdirp dist/images",
    "dev": "npm run mkdir && npm run copy && concurrently \"npm run watch:css\" \"npm run serve\"",
    "build": "npm run clean && npm run mkdir && npm run build:css && npm run copy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "copyfiles": "^2.4.1",
    "live-server": "^1.2.2",
    "mkdirp": "^3.0.1",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.17"
  }
}
