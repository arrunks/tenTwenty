{
  "name": "farm-website",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "watch:css": "tailwindcss -i ./styles.css -o ./dist/output.css --watch",
    "build:css": "tailwindcss -i ./styles.css -o ./dist/output.css",
    "serve": "live-server --port=3000 --no-browser",
    "dev": "concurrently \"npm run watch:css\" \"npm run serve\"",
    "build": "rm -rf dist && mkdir -p dist && npm run build:css && cp -r public dist/ && cp index.html dist/ && ls -la dist"
  },
  
  "keywords": [],
